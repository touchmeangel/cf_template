{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++17",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run C++",
            "type": "shell",
            "command": "./${fileBasenameNoExtension}",
            "dependsOn": "Build C++17",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": []
        }
    ]
}